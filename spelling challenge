    def animate_scene(self):
        self.animation_phase += 1
        if self.scene_canvas.winfo_exists():
            for index in range(9):
                x = 30 + (index * 127 + self.animation_phase * (index % 3 + 1)) % max(self.scene_canvas.winfo_width() - 60, 600)
                y = 18 + (index * 29) % 90
                tag = f"star{index}"
                self.scene_canvas.delete(tag)
                size = 2 + ((self.animation_phase + index) % 4)
                self.scene_canvas.create_oval(x-size,y-size,x+size,y+size,fill=CYAN,outline="",tags=tag)
        self.after(100, self.animate_scene)

    def sparkle_burst(self):
        for i in range(18):
            x = random.randint(80, max(100, self.scene_canvas.winfo_width()-80))
            y = random.randint(18, 110)
            size = random.randint(2, 6)
            self.scene_canvas.create_oval(x-size,y-size,x+size,y+size,fill=GOLD,outline="",tags="burst")
        self.after(1000, lambda: self.scene_canvas.delete("burst"))

    def draw_progress(self):
        if not hasattr(self, "progress_canvas"):
            return
        c = self.progress_canvas
        c.delete("all")
        width = max(c.winfo_width(), 300)
        ratio = (self.round_index + (1 if self.completed else 0)) / len(ROUNDS)
        c.create_rectangle(0, 0, width, 18, fill="white", outline="")
        c.create_rectangle(0, 0, width * ratio, 18, fill="#2563eb", outline="")

    def close_game(self):
        self.cancel_auto_next()
        self.music_stop_event.set()
        self.stop_speech()
        self.destroy()


if __name__ == "__main__":
    SpellingGame().mainloop()

