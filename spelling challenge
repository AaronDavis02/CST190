    def create_tiles(self):
        for tile in self.tiles:
            tile.destroy()
        letters = list(self.current_round.word)
        random.shuffle(letters)
        self.tiles = [LetterTile(self.tile_area, self, letter, index) for index, letter in enumerate(letters)]
        self.after(40, self.layout_tiles)

    def layout_tiles(self):
        if not self.tiles or not self.tile_area.winfo_exists():
            return
        active = [tile for tile in self.tiles if tile.winfo_exists()]
        if not active:
            return
        width = max(self.tile_area.winfo_width(), 600)
        count = len(active)
        tile_width = 82 if count <= 7 else 66 if count <= 9 else 55
        gap = 15 if count <= 7 else 8 if count <= 9 else 5
        total = len(active) * tile_width + max(0, len(active) - 1) * gap
        x = max(15, (width - total) // 2)
        for tile in active:
            tile.config(font=(FONT, 28 if tile_width >= 66 else 22, "bold"))
            tile.place(x=x, y=20, width=tile_width, height=78)
            x += tile_width + gap

    def draw_slots(self):
        for widget in self.drop_frame.winfo_children():
            widget.destroy()
        for index, letter in enumerate(self.current_round.word):
            shown = self.placed[index] if index < len(self.placed) else ""
            colour = "#dff8ff" if shown else "#204a7b"
            fg = NAVY if shown else "#204a7b"
            slot = tk.Label(self.drop_frame, text=shown, bg=colour, fg=fg, font=(FONT, 27, "bold"), width=3, height=1, bd=4, relief="ridge")
            slot.pack(side="left", expand=True, padx=6, pady=13)

    def cancel_auto_next(self):
        if self.auto_next_job is not None:
            try:
                self.after_cancel(self.auto_next_job)
            except Exception:
                pass
            self.auto_next_job = None

    def start_round(self, index: int):
        self.cancel_auto_next()
        self.round_index = index
        self.placed = []
        self.completed = False
        self.celebration.pack_forget()
        self.round_stat.config(text=f"{index + 1} of {len(ROUNDS)}")
        self.score_stat.config(text=str(self.score))
        self.level_var.set(f"{self.current_round.level}  |  {self.current_round.pattern}")
        self.clue_var.set(self.current_round.clue)
        self.message_var.set("Drag the letters into the glowing boxes.")
        self.message_label.config(fg="#cffafe")
        self.draw_slots()
        self.create_tiles()
        self.redraw_picture()
        self.draw_progress()
        self.after(350, self.play_clue)

    def attempt_tile(self, tile: LetterTile):
        if self.completed or not tile.winfo_exists():
            return
        expected = self.current_round.word[len(self.placed)]
        if tile.letter == expected:
            self.placed.append(tile.letter)
            tile.destroy()
            self.tiles = [item for item in self.tiles if item is not tile]
            self.draw_slots()
            self.layout_tiles()
            self.message_var.set("Great! Now find the next letter.")
            self.message_label.config(fg="#bbf7d0")
            self.speak(tile.letter)
            if "".join(self.placed) == self.current_round.word:
                self.complete_round()
        else:
            self.message_var.set("That letter belongs somewhere else. Try another one.")
            self.message_label.config(fg="#fecaca")
            self.shake(tile)
            self.speak("Try another letter")

    def complete_round(self):
        self.completed = True
        self.score += 10
        self.score_stat.config(text=str(self.score))
        word = self.current_round.word
        self.message_var.set(f"Wonderful! You spelled {word}!")
        self.message_label.config(fg="#fde68a")
        self.next_button.config(text="Next Word Now" if self.round_index < len(ROUNDS) - 1 else "Finish Quest")
        self.celebration.pack(fill="x", padx=22, pady=(0, 8), before=self.progress_canvas)
        self.draw_progress()
        self.speak(f"Wonderful. You spelled {word.lower()}")
        self.sparkle_burst()
        self.countdown_value = 4
        self.update_auto_next_countdown()

    def update_auto_next_countdown(self):
        if not self.completed:
            return
        word = self.current_round.word
        if self.countdown_value <= 0:
            self.auto_next_job = None
            self.next_round()
            return
        if self.round_index < len(ROUNDS) - 1:
            self.celebration_text.config(text=f"CRYSTAL COLLECTED!  +10 points for {word}\nNext spelling round begins in {self.countdown_value}...")
        else:
            self.celebration_text.config(text=f"FINAL CRYSTAL COLLECTED!  +10 points for {word}\nQuest results open in {self.countdown_value}...")
        self.countdown_value -= 1
        self.auto_next_job = self.after(1000, self.update_auto_next_countdown)

    def next_round(self):
        self.cancel_auto_next()
        if self.round_index < len(ROUNDS) - 1:
            self.start_round(self.round_index + 1)
        else:
            self.speak("You completed the Crystal Caves spelling quest")
            messagebox.showinfo("Quest complete", f"You completed the Crystal Caves spelling quest!\n\nFinal score: {self.score} crystal points.", parent=self)

    def reset_round(self):
