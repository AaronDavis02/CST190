        self.message_label.config(fg="#cffafe")
        self.draw_slots()
        self.create_tiles()
        self.draw_progress()

    def point_in_widget(self, root_x, root_y, widget):
        return widget.winfo_rootx() <= root_x <= widget.winfo_rootx() + widget.winfo_width() and widget.winfo_rooty() <= root_y <= widget.winfo_rooty() + widget.winfo_height()

    def shake(self, widget, step=0):
        if not widget.winfo_exists():
            return
        offsets = [-12, 12, -9, 9, -5, 5, 0]
        if step >= len(offsets):
            self.layout_tiles()
            return
        info = widget.place_info()
        base_x = int(float(info.get("x", 0)))
        widget.place_configure(x=base_x + offsets[step])
        self.after(55, lambda: self.shake(widget, step + 1))

    def start_music(self):
        if not self.music_on or (self.music_thread and self.music_thread.is_alive()):
            return
        self.music_stop_event.clear()
        self.music_thread = threading.Thread(target=self.music_loop, daemon=True)
        self.music_thread.start()

    def music_loop(self):
        if sys.platform != "win32":
            return
        try:
            import winsound
            while not self.music_stop_event.is_set():
                for frequency, duration in MUSIC_NOTES:
                    if self.music_stop_event.is_set():
                        return
                    # Quiet, separated notes make the melody less intrusive.
                    winsound.Beep(frequency, duration)
                    if self.music_stop_event.wait(0.10):
                        return
                if self.music_stop_event.wait(1.2):
                    return
        except Exception:
            return

    def toggle_music(self):
        self.music_on = not self.music_on
        self.music_button.config(text="Music On" if self.music_on else "Music Off")
        if self.music_on:
            self.start_music()
        else:
            self.music_stop_event.set()

    def toggle_sound(self):
        self.sound_on = not self.sound_on
        self.sound_button.config(text="Sound On" if self.sound_on else "Sound Off")
        if not self.sound_on:
            self.stop_speech()

    def play_clue(self):
        self.speak(f"{self.current_round.clue}. Spell {self.current_round.word.lower()}")

    def stop_speech(self):
        with self.speech_lock:
            process = self.speech_process
            self.speech_process = None
        if process and process.poll() is None:
            try:
                process.terminate()
            except Exception:
                pass

    def speak(self, text: str):
        if not self.sound_on:
            return
        self.stop_speech()

        def worker():
            try:
                if sys.platform == "win32":
                    import subprocess
                    safe = text.replace("'", "''")
                    script = (
                        "Add-Type -AssemblyName System.Speech; "
                        "$s=New-Object System.Speech.Synthesis.SpeechSynthesizer; "
                        "$s.Rate=-1; $s.Volume=100; "
                        f"$s.Speak('{safe}')"
                    )
                    process = subprocess.Popen(
                        ["powershell.exe", "-NoProfile", "-ExecutionPolicy", "Bypass", "-Command", script],
                        stdout=subprocess.DEVNULL,
                        stderr=subprocess.DEVNULL,
                        creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0),
                    )
                    with self.speech_lock:
                        self.speech_process = process
                    process.wait()
                else:
                    try:
                        import pyttsx3
                        engine = pyttsx3.init()
                        engine.setProperty("rate", 155)
                        engine.say(text)
                        engine.runAndWait()
                    except Exception:
                        pass
            finally:
                with self.speech_lock:
                    self.speech_process = None

        threading.Thread(target=worker, daemon=True).start()

