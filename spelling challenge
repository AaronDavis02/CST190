class LetterTile(tk.Label):
    """A large draggable and clickable letter tile."""

    def __init__(self, master, game: "SpellingGame", letter: str, tile_id: int):
        super().__init__(
            master,
            text=letter,
            font=(FONT, 28, "bold"),
            bg="#bae6fd",
            fg=NAVY,
            width=3,
            height=1,
            bd=4,
            relief="raised",
            cursor="hand2",
            padx=6,
            pady=9,
        )
        self.game = game
        self.letter = letter
        self.tile_id = tile_id
        self.dragging = False
        self.start_x = 0
        self.start_y = 0
        self.bind("<ButtonPress-1>", self.begin_drag)
        self.bind("<B1-Motion>", self.drag)
        self.bind("<ButtonRelease-1>", self.drop)
        self.bind("<Return>", lambda _event: self.game.attempt_tile(self))
        self.configure(takefocus=True)

    def begin_drag(self, event):
        self.dragging = False
        self.start_x = event.x_root
        self.start_y = event.y_root
        self.lift()

    def drag(self, event):
        if abs(event.x_root - self.start_x) + abs(event.y_root - self.start_y) > 6:
            self.dragging = True
        self.place(
            x=event.x_root - self.master.winfo_rootx() - self.winfo_width() // 2,
            y=event.y_root - self.master.winfo_rooty() - self.winfo_height() // 2,
        )

    def drop(self, event):
        over_target = self.game.point_in_widget(event.x_root, event.y_root, self.game.drop_frame)
        if self.dragging and over_target:
            self.game.attempt_tile(self)
        elif not self.dragging:
            self.game.attempt_tile(self)
        else:
            self.game.layout_tiles()


